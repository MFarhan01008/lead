<!doctype html>
<html>
  <head>
    <title>Edit Restaurant</title>
    <link rel="stylesheet" href="/public/styles.css" />
  </head>
  <body>
    <main class="container">
      <a href="/admin">← Back</a>
      <h1>Edit <%= restaurant.name %></h1>
      <form method="post">
        <label>Name <input name="name" value="<%= restaurant.name %>" /></label>
        <label>Staff WhatsApp <input name="staff_whatsapp" value="<%= restaurant.staff_whatsapp %>" /></label>
        <label>Delivery Areas (comma-separated)
          <input name="delivery_areas" value="<%= restaurant.delivery_areas.join(', ') %>" />
        </label>
        <label>Delivery Charges JSON
          <textarea name="delivery_charges_json"><%= JSON.stringify(restaurant.delivery_charges, null, 2) %></textarea>
        </label>
        <label>FAQs JSON
          <textarea name="faqs_json"><%= JSON.stringify(restaurant.faqs, null, 2) %></textarea>
        </label>

        <h3>Menu Items</h3>
        <% menu.forEach(function(item){ %>
          <div class="menu-row">
            <input name="menu_name" value="<%= item.name %>" placeholder="Name" />
            <input name="menu_description" value="<%= item.description %>" placeholder="Description" />
            <input name="menu_price" value="<%= item.price %>" placeholder="Price" type="number" step="0.01" />
          </div>
        <% }) %>

        <button type="submit">Save</button>
      </form>
    </main>
  </body>
</html>
